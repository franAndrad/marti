---
const icons = [
  '🥑', '🍎', '🥗', '🍓', '🥦', '🫐', '🍊', '🥕',
  '💊', '🩺', '🌹', '🌸', '💕', '❤️', '🌻', '🌷',
  '👻', '🍕', '🔪', '🦇',
];

const ecgPath =
  'M0,50 H70 L90,18 L110,84 L130,50 H240 L260,12 L280,88 L300,50 ' +
  'H410 L430,8 L450,92 L470,50 H580 L600,20 L620,80 L640,50 ' +
  'H750 L770,4 L790,96 L810,50 H900';

const growthPath = 'M100,600 L100,20';

const leaves = [
  { id: 'leaf-1', top: '84%', icon: '🥑', label: 'hoy: nutrición, mil recetas y poca plata' },
  { id: 'leaf-2', top: '64%', icon: '🥗', label: 'prácticas, informes, trasnochadas' },
  { id: 'leaf-3', top: '44%', icon: '🍎', label: 'constancia, todos los días' },
  { id: 'leaf-4', top: '24%', icon: '🌱', label: 'cada vez más cerca' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fran &amp; Marti</title>
    <meta
      name="description"
      content="Para Martina: estudia nutrición, sueña con ser médica, y mientras tanto se ganó todo mi corazón."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>❤️</text></svg>"
    />
  </head>
  <body>
    <div class="progress-bar" id="progress-bar"></div>
    <div class="bg-layer" id="bg-layer"></div>

    <div class="floaters" id="floaters" aria-hidden="true">
      {icons.map((icon) => (
        <span class="floater">{icon}</span>
      ))}
    </div>

    <main>
      <section class="scene scene-intro" id="scene-intro">
        <p class="tag" id="intro-tag">expediente confidencial · caso Fran &amp; Marti</p>
        <h1 class="glitch" id="intro-title" data-text="TODAVÍA NO ES DOCTORA">
          TODAVÍA NO ES DOCTORA
        </h1>
        <p class="scene-sub" id="intro-sub">pero ya me salvó a mí, hace rato.</p>
        <p class="scroll-cue" id="intro-cue">deslizá ↓</p>
      </section>

      <section class="scene scene-ecg" id="scene-ecg">
        <p class="scene-label reveal">hallazgo clínico</p>
        <h2 class="reveal">El pulso se acelera cada vez que te veo.</h2>
        <div class="ecg-wrap reveal">
          <svg class="ecg" viewBox="0 0 900 100" preserveAspectRatio="none">
            <path id="ecg-path" d={ecgPath} />
          </svg>
          <span class="ecg-heart" id="ecg-heart">❤️</span>
        </div>
        <p class="scene-sub reveal">no hay tratamiento. no lo quiero.</p>
      </section>

      <section class="scene scene-growth" id="scene-growth">
        <p class="scene-label reveal">camino recorrido</p>
        <h2 class="reveal">De la nutrición a la bata blanca, paso a paso.</h2>
        <div class="growth-wrap" id="growth-wrap">
          <svg class="growth-svg" viewBox="0 0 200 620" preserveAspectRatio="xMidYMid meet">
            <path id="growth-path" d={growthPath} />
          </svg>

          {leaves.map((leaf) => (
            <div class="leaf" id={leaf.id} style={`top:${leaf.top}`}>
              <span class="leaf-inner">
                <span class="leaf-icon">{leaf.icon}</span>
                <span class="leaf-label">{leaf.label}</span>
              </span>
            </div>
          ))}

          <div class="leaf leaf-blossom" id="leaf-5" style="top:8%">
            <span class="leaf-inner">
              <span class="leaf-icon">🩺</span>
              <span class="leaf-label">mañana: Dra. Martina</span>
            </span>
          </div>
        </div>
      </section>

      <section class="scene scene-final" id="scene-final">
        <p class="tag reveal">para vos, Marti</p>
        <h2 class="final-title reveal">Todo va a estar bien.</h2>
        <div class="message reveal">
          <p>
            Sé que estudiar no es fácil: anatomía, bioquímica, prácticas que se comen
            los fines de semana. Y sé que tu sueño real —ser médica— todavía te queda
            camino por recorrer. Pero quiero que sepas algo: <strong>vas a llegar</strong>,
            un paso a la vez.
          </p>
          <p>
            Y mientras tanto, acá estoy yo: para los mates de las 2 AM estudiando, para
            escucharte repasar en voz alta, para lo que necesites.
          </p>
          <p class="signature">Te amo, Marti. — Fran 🖤🩺</p>
        </div>
        <button id="reveal-btn" class="btn reveal">un beso más 💋</button>
      </section>
    </main>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // --- floating ambient icons (kept subtle: texture, not focus) ---
      const floaters = document.querySelectorAll<HTMLElement>('.floater');

      floaters.forEach((el) => {
        const startX = Math.random() * 100;
        const size = 1 + Math.random() * 1.4;
        const duration = 12 + Math.random() * 16;
        const delay = Math.random() * -24;
        const drift = (Math.random() - 0.5) * 180;
        const maxOpacity = 0.35 + Math.random() * 0.25;

        el.style.left = `${startX}vw`;
        el.style.fontSize = `${size}rem`;

        gsap.set(el, { y: '110vh', opacity: 0 });

        gsap.to(el, {
          y: '-10vh',
          x: `+=${drift}`,
          opacity: maxOpacity,
          duration,
          delay,
          repeat: -1,
          ease: 'none',
          onRepeat: () => {
            gsap.set(el, { y: '110vh', x: 0 });
          },
        });

        gsap.to(el, {
          rotation: (Math.random() - 0.5) * 50,
          duration: 4 + Math.random() * 3,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
        });
      });

      // --- scroll progress bar + background parallax ---
      ScrollTrigger.create({
        start: 0,
        end: 'max',
        onUpdate: (self) => {
          gsap.set('#progress-bar', { scaleX: self.progress });
        },
      });

      gsap.to('#bg-layer', {
        yPercent: 12,
        ease: 'none',
        scrollTrigger: { start: 0, end: 'max', scrub: true },
      });

      // --- intro entrance ---
      const introTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      introTl
        .from('#intro-tag', { y: -20, opacity: 0, duration: 0.6 })
        .from('#intro-title', { y: 30, opacity: 0, duration: 0.9 }, '-=0.2')
        .from('#intro-sub', { y: 20, opacity: 0, duration: 0.6 }, '-=0.3')
        .from('#intro-cue', { opacity: 0, duration: 0.6 }, '-=0.2');

      gsap.to('#intro-cue', {
        y: 8,
        duration: 1,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
      });

      // --- generic scroll reveal for later scenes ---
      gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            toggleActions: 'play none none reverse',
          },
        });
      });

      // --- heartbeat monitor tied to scroll ---
      const ecgPathEl = document.getElementById('ecg-path') as unknown as SVGPathElement | null;
      const ecgHeart = document.getElementById('ecg-heart');

      if (ecgPathEl) {
        const len = ecgPathEl.getTotalLength();
        gsap.set(ecgPathEl, { strokeDasharray: len, strokeDashoffset: len });
        gsap.set(ecgHeart, { scale: 0, opacity: 0 });

        gsap
          .timeline({
            scrollTrigger: {
              trigger: '#scene-ecg',
              start: 'top 70%',
              end: 'bottom 50%',
              scrub: 0.4,
            },
          })
          .to(ecgPathEl, { strokeDashoffset: 0, ease: 'none' })
          .to(ecgHeart, { scale: 1.5, opacity: 1, ease: 'power2.out' }, '-=0.15')
          .to(ecgHeart, { scale: 1.2, duration: 0.3, ease: 'power1.inOut' });
      }

      // --- growth path: nutrición -> Dra. Martina, pinned scrollytelling ---
      const growthPathEl = document.getElementById('growth-path') as unknown as SVGPathElement | null;

      gsap.set('.leaf-inner', { opacity: 0, scale: 0.4 });

      if (growthPathEl) {
        const glen = growthPathEl.getTotalLength();
        gsap.set(growthPathEl, { strokeDasharray: glen, strokeDashoffset: glen });

        const growthTl = gsap.timeline({
          scrollTrigger: {
            trigger: '#scene-growth',
            start: 'top top',
            end: '+=140%',
            scrub: 0.6,
            pin: true,
          },
        });

        growthTl.to(growthPathEl, { strokeDashoffset: 0, duration: 1, ease: 'none' });

        const leafSteps: Array<[string, number]> = [
          ['#leaf-1 .leaf-inner', 0.08],
          ['#leaf-2 .leaf-inner', 0.32],
          ['#leaf-3 .leaf-inner', 0.54],
          ['#leaf-4 .leaf-inner', 0.76],
          ['#leaf-5 .leaf-inner', 0.94],
        ];

        leafSteps.forEach(([selector, pos]) => {
          growthTl.to(
            selector,
            { opacity: 1, scale: 1, duration: 0.1, ease: 'back.out(2)' },
            pos
          );
        });
      }

      // --- final scene: kiss burst ---
      const btn = document.getElementById('reveal-btn');

      function burst() {
        const emojis = ['❤️', '💋', '🌹', '🌸', '💕'];
        for (let i = 0; i < 24; i++) {
          const span = document.createElement('span');
          span.textContent = emojis[Math.floor(Math.random() * emojis.length)];
          span.className = 'burst-particle';
          document.body.appendChild(span);

          const x = window.innerWidth / 2 + (Math.random() - 0.5) * 200;
          const y = window.innerHeight * 0.6;
          gsap.set(span, { position: 'fixed', left: x, top: y, fontSize: '1.5rem', zIndex: 50 });

          gsap.to(span, {
            x: (Math.random() - 0.5) * 500,
            y: (Math.random() - 0.5) * 400 - 100,
            rotation: (Math.random() - 0.5) * 360,
            opacity: 0,
            duration: 1.4 + Math.random(),
            ease: 'power2.out',
            onComplete: () => span.remove(),
          });
        }
      }

      btn?.addEventListener('click', burst);
    </script>

    <style>
      :root {
        color-scheme: dark;
        --bg-a: #120014;
        --bg-b: #1a0b2e;
        --accent: #ff2e63;
        --accent-2: #08d9d6;
        --cream: #fff2e0;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        height: 100%;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        font-family: 'Georgia', 'Times New Roman', serif;
        color: var(--cream);
        overflow-x: hidden;
        position: relative;
      }

      .progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 100%;
        background: linear-gradient(90deg, var(--accent), var(--accent-2));
        transform-origin: left;
        transform: scaleX(0);
        z-index: 100;
      }

      .bg-layer {
        position: fixed;
        inset: -10% 0;
        z-index: -2;
        background: radial-gradient(circle at 20% 20%, #3a0d4d 0%, var(--bg-a) 45%, #05000a 100%);
      }

      .bg-layer::after {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-radial-gradient(circle at 80% 70%, rgba(8, 217, 214, 0.08) 0, transparent 6%);
      }

      .floaters {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        overflow: hidden;
      }

      .floater {
        position: absolute;
        top: 0;
        will-change: transform, opacity;
        filter: drop-shadow(0 0 4px rgba(0, 0, 0, 0.35));
      }

      main {
        position: relative;
      }

      .scene {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 4rem 1.25rem;
        max-width: 720px;
        margin: 0 auto;
      }

      .tag,
      .scene-label {
        letter-spacing: 0.3em;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: var(--accent-2);
        margin: 0 0 1rem;
      }

      h1,
      .scene h2 {
        font-size: clamp(1.9rem, 6.5vw, 3.4rem);
        line-height: 1.15;
        margin: 0 0 1rem;
      }

      .scene-sub {
        font-size: 1.05rem;
        opacity: 0.85;
        max-width: 480px;
        margin: 0.5rem auto 0;
      }

      /* intro */

      .scene-intro h1 {
        color: var(--accent);
        text-shadow: 0 0 30px rgba(255, 46, 99, 0.45);
      }

      .glitch {
        position: relative;
      }

      .glitch::before,
      .glitch::after {
        content: attr(data-text);
        position: absolute;
        inset: 0;
        background: transparent;
      }

      .glitch::before {
        left: 3px;
        color: var(--accent-2);
        text-shadow: -2px 0 var(--accent-2);
        animation: glitch-1 3.4s infinite linear alternate-reverse;
      }

      .glitch::after {
        left: -3px;
        color: var(--accent);
        text-shadow: 2px 0 #ffb238;
        animation: glitch-2 2.8s infinite linear alternate-reverse;
      }

      @keyframes glitch-1 {
        0% {
          clip-path: inset(10% 0 60% 0);
        }
        20% {
          clip-path: inset(80% 0 2% 0);
        }
        40% {
          clip-path: inset(40% 0 40% 0);
        }
        60% {
          clip-path: inset(10% 0 75% 0);
        }
        80% {
          clip-path: inset(60% 0 15% 0);
        }
        100% {
          clip-path: inset(20% 0 55% 0);
        }
      }

      @keyframes glitch-2 {
        0% {
          clip-path: inset(70% 0 5% 0);
        }
        25% {
          clip-path: inset(15% 0 65% 0);
        }
        50% {
          clip-path: inset(45% 0 35% 0);
        }
        75% {
          clip-path: inset(5% 0 80% 0);
        }
        100% {
          clip-path: inset(55% 0 20% 0);
        }
      }

      .scroll-cue {
        margin-top: 2.5rem;
        font-size: 0.85rem;
        opacity: 0.6;
        letter-spacing: 0.1em;
      }

      /* ecg */

      .ecg-wrap {
        position: relative;
        width: 100%;
        max-width: 560px;
        margin: 1.5rem auto;
      }

      .ecg {
        width: 100%;
        height: auto;
        overflow: visible;
      }

      .ecg path {
        fill: none;
        stroke: var(--accent);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
        filter: drop-shadow(0 0 8px rgba(255, 46, 99, 0.6));
      }

      .ecg-heart {
        position: absolute;
        right: -0.4rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 2rem;
      }

      /* growth */

      .scene-growth {
        max-width: 100%;
      }

      .growth-wrap {
        position: relative;
        width: min(260px, 70vw);
        aspect-ratio: 200 / 620;
        margin: 1rem auto 0;
      }

      .growth-svg {
        width: 100%;
        height: 100%;
        display: block;
        overflow: visible;
      }

      .growth-svg path {
        fill: none;
        stroke: var(--accent-2);
        stroke-width: 3;
        stroke-linecap: round;
        filter: drop-shadow(0 0 6px rgba(8, 217, 214, 0.45));
      }

      .leaf {
        position: absolute;
        left: 50%;
        transform: translate(14px, -50%);
      }

      .leaf-inner {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        white-space: nowrap;
      }

      .leaf-icon {
        font-size: 1.6rem;
        line-height: 1;
      }

      .leaf-label {
        font-size: 0.8rem;
        opacity: 0.85;
        max-width: 190px;
        white-space: normal;
        text-align: left;
      }

      .leaf-blossom {
        transform: translate(-50%, -50%);
      }

      .leaf-blossom .leaf-inner {
        flex-direction: column;
        gap: 0.3rem;
        white-space: normal;
      }

      .leaf-blossom .leaf-icon {
        font-size: 2.6rem;
        filter: drop-shadow(0 0 12px rgba(255, 46, 99, 0.5));
      }

      .leaf-blossom .leaf-label {
        color: var(--accent-2);
        font-weight: bold;
        text-align: center;
        white-space: nowrap;
      }

      /* final */

      .final-title {
        color: var(--accent-2);
        text-shadow: 0 0 24px rgba(8, 217, 214, 0.4);
      }

      .message {
        margin-top: 1.5rem;
        text-align: left;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        padding: 1.75rem 2rem;
        backdrop-filter: blur(6px);
      }

      .message p {
        line-height: 1.6;
        font-size: 1.05rem;
      }

      .message .signature {
        margin-top: 1.25rem;
        text-align: right;
        font-style: italic;
        color: var(--accent-2);
      }

      .btn {
        font-family: inherit;
        font-size: 1.05rem;
        padding: 0.85rem 2rem;
        border-radius: 999px;
        border: 2px solid var(--accent);
        background: rgba(255, 46, 99, 0.12);
        color: var(--cream);
        cursor: pointer;
        margin-top: 2rem;
        transition: background 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 0 20px rgba(255, 46, 99, 0.25);
      }

      .btn:hover {
        background: rgba(255, 46, 99, 0.28);
        box-shadow: 0 0 32px rgba(255, 46, 99, 0.45);
      }

      @media (max-width: 480px) {
        .scene {
          padding: 3rem 1rem;
        }

        .message {
          padding: 1.25rem 1.25rem;
        }

        .growth-wrap {
          width: min(220px, 78vw);
        }

        .leaf-label {
          max-width: 140px;
        }
      }
    </style>
  </body>
</html>
